# ── LLM provider ─────────────────────────────────────────────────────────────
# Options: gemini | openai | ollama | groq | litellm
LLM_PROVIDER=gemini

# Gemini
GOOGLE_API_KEY=your_google_ai_api_key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama local (only needed if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Groq (only needed if LLM_PROVIDER=groq)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# LiteLLM — one interface for 100+ models (https://docs.litellm.ai/docs/providers)
# Set LLM_PROVIDER=litellm and pick any supported model string.
# LiteLLM reads the right API key from env automatically.
# Examples:
#   LITELLM_MODEL=gemini/gemini-2.5-flash        (needs GOOGLE_API_KEY)
#   LITELLM_MODEL=anthropic/claude-opus-4-7      (needs ANTHROPIC_API_KEY)
#   LITELLM_MODEL=openai/gpt-4o                  (needs OPENAI_API_KEY)
#   LITELLM_MODEL=groq/llama-3.1-8b-instant      (needs GROQ_API_KEY)
#   LITELLM_MODEL=ollama/llama3.2                (needs Ollama running locally)
# LITELLM_MODEL=gemini/gemini-2.5-flash
# ANTHROPIC_API_KEY=sk-ant-...

# ── Langfuse observability ────────────────────────────────────────────────────
# Get keys from http://localhost:3000 after running docker compose up
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://localhost:3000

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated API keys; leave empty to disable auth
API_KEYS=
RATE_LIMIT=30/minute

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
