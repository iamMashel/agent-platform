# ── LLM provider ─────────────────────────────────────────────────────────────
# Options: gemini | openai | ollama | groq
LLM_PROVIDER=gemini

# Gemini
GOOGLE_API_KEY=your_google_ai_api_key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama local (only needed if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Groq (only needed if LLM_PROVIDER=groq)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# ── Langfuse observability ────────────────────────────────────────────────────
# Get keys from http://localhost:3000 after running docker compose up
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated API keys; leave empty to disable auth
API_KEYS=
RATE_LIMIT=30/minute

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
